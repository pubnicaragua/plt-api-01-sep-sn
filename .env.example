PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://incoex:change-me@localhost:5432/incoex
JWT_SECRET=replace-before-production
MAPS_PROVIDER=google
# Clave para llamadas SERVIDOR (Google Places autocomplete/detail y geocoding).
# IMPORTANTE: crea una API key de servidor SIN restricción de sitios web
# (o restringida por IP). Con restricción "Websites" Google responde
# REQUEST_DENIED a las llamadas del servidor. Deja vacía para usar el
# catálogo local de Managua.
GOOGLE_MAPS_API_KEY=

# Persistencia local (SQLite)
# Ruta de la base SQLite. Por defecto: data/incoex-local.sqlite
INCOEX_DB_PATH=

# Carpeta de fotos de flota. Por defecto: data/uploads/vehicles
INCOEX_UPLOADS_PATH=

# --- Render (https://plt-api-01-sep-sn.onrender.com) ---
# Con disco persistente montado (Render Dashboard → Disks):
#   INCOEX_DB_PATH=/var/data/incoex-local.sqlite
#   INCOEX_UPLOADS_PATH=/var/data/uploads/vehicles
#   FRONTEND_ORIGIN=https://plt-web-01-sep-sn.vercel.app
# Sin disco persistente, la base y las fotos se reinician en cada deploy.
